{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo sem build",
  "installCommand": "npm install --omit=optional --ignore-scripts",
  "outputDirectory": "painel",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }, { "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": { "api/index.js": { "maxDuration": 60 } }
}
